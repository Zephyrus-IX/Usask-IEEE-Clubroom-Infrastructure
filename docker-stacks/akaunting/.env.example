# Akaunting stack example environment.
# Copy these values into Dockhand's stack environment or create a live .env file
# on the server. Do not commit live .env files.

# Host port exposed by the Akaunting web container. Caddy can proxy to this.
AKAUNTING_HTTP_PORT=8081

# First-run setup flag.
# Set to true for initial deployment only. After completing the browser setup
# wizard, change this to false or remove it and redeploy.
AKAUNTING_SETUP=true

# Public/local URL used by Akaunting.
APP_URL=http://finance.ieee.local
LOCALE=en-US

# Database settings. MYSQL_PASSWORD must be changed before deployment.
MYSQL_DATABASE=akaunting
MYSQL_USER=akaunting
MYSQL_PASSWORD=change_me_to_a_long_random_password

# Akaunting requires a random 3-character prefix followed by an underscore.
# Example: a7f_
DB_PREFIX=chg_

# Initial company/admin setup values. Used only while AKAUNTING_SETUP=true.
COMPANY_NAME=USask IEEE Student Branch
COMPANY_EMAIL=treasurer@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_long_random_password
