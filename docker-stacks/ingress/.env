# Ingress stack environment template for Dockhand.
# Dockhand reads .env directly and can apply local overrides.
# Keep committed values non-secret placeholders/defaults only.

# Caddy local HTTP/HTTPS listener ports.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Cloudflare Tunnel token. Set the real value only in Dockhand/local overrides.
# Do not commit the real token to Git.
CLOUDFLARED_TUNNEL_TOKEN=change_me_in_dockhand
