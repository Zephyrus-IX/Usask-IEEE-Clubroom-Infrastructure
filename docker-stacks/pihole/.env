# Pi-hole stack environment template for Dockhand.
# Dockhand reads .env directly and can apply local overrides.
# Keep committed values non-secret placeholders/defaults only.

TZ=America/Regina

# Web admin UI. Caddy proxies pihole.ieee.local to this host port.
PIHOLE_WEB_PORT=8082

# Trial DNS port. Keep this at 5353 while host dnsmasq owns LAN DNS/DHCP on port 53.
# Later, if Pi-hole replaces host DNS, migrate deliberately and change this to 53.
PIHOLE_DNS_PORT=5353

# Change through Dockhand/local override before deployment.
PIHOLE_WEB_PASSWORD=change_me_before_deploying

# Semicolon-separated upstream resolvers for Pi-hole FTL.
PIHOLE_DNS_UPSTREAMS=8.8.8.8;1.1.1.1

# Required when clients query Pi-hole from outside the container network.
PIHOLE_DNS_LISTENING_MODE=all
