# Live environment/secrets
# Root/local env files stay ignored. Stack-level docker-stacks/**/.env files are
# committed as Dockhand templates with placeholder values because Dockhand reads
# .env directly and lets operators apply local overrides.
.env
.env.*
!docker-stacks/**/.env

# Runtime data and local state
data/
logs/
*.log
*.sqlite
*.sqlite3
*.db

# OS/editor noise
.DS_Store
.vscode/
.idea/
